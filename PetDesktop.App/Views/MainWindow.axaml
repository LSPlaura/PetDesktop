<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        xmlns:behaviors="clr-namespace:PetDesktop.App.Behaviors"
        xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions.Core"
        xmlns:vm="clr-namespace:PetDesktop.App.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d" 
        d:DesignWidth="300" d:DesignHeight="300"
        Width="300" Height="300"
        x:Class="PetDesktop.App.Views.MainWindow"
        x:CompileBindings="False"
        Title="PetDesktop"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Grid Background="Transparent">
        <i:Interaction.Behaviors>
            <!-- "Escucha cuando la ventana termine de cargarse en pantalla" -->
            <EventTriggerBehavior EventName="Loaded">
                <!-- "En cuanto se cargue, pulsa/ejecuta este comando" -->
                <InvokeCommandAction Command="{Binding CreateDefaultPetAsyncCommand}" />
            </EventTriggerBehavior>
            <behaviors:DrawWindowBehavior></behaviors:DrawWindowBehavior>
            <behaviors:AnimationBehaviour CurrentDirection="{Binding Path=PetDirection, Mode=TwoWay}" />
        </i:Interaction.Behaviors>
        
        <TextBlock Text="Welcome to Avalonia!" 
                   FontSize="20" 
                   Foreground="White"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>